{
  "name": "worldwar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Singleplayer strategy game - Supremacy-style clone. No monetization, adjustable game speed.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:requirements": "node scripts/requirements-coverage.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "build": "tsc --noEmit && echo build-ok",
    "map:build": "node scripts/not-yet.mjs map:build T-M9-02a",
    "sim:long": "node scripts/not-yet.mjs sim:long T-M8-02",
    "sim:tournament": "vitest run --config vitest.slow.config.ts apps/headless/test/tournament.slow.test.ts",
    "bench": "vitest run --config vitest.slow.config.ts packages/core/test/perf",
    "balance:sweep": "node scripts/not-yet.mjs balance:sweep T-M12-00",
    "dev": "pnpm --filter @worldwar/desktop dev",
    "tauri:dev": "node scripts/not-yet.mjs tauri:dev T-M11-03",
    "tauri:build": "node scripts/not-yet.mjs tauri:build T-M11-03",
    "desktop:build": "pnpm --filter @worldwar/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "fast-check": "^4.4.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shapefile": "^0.6.6",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
